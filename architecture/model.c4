// Starter spec, read from the code and traces by portal (no AI).
// It says what exists. Add what the code can't: domains, your names,
// rules, and what you plan to build.
// Conventions: https://portal.haris-d21.workers.dev/skills/portal-architecture/SKILL.md
model {
  system = domain 'wild-workouts-go-ddd-example' {
    service = service 'service' {  // terraform/service/service.tf:18
      technology 'Cloud Run'
      metadata {
        resource 'service'
      }
    }
    web = service 'web' {  // docker-compose.yml:4
      technology 'JavaScript'
      metadata {
        code 'web/**'
        otel_service 'web'
        resource 'web'
      }
      src = component 'src' {
        metadata {
          code 'web/src/*'
        }
      }
      repositories = component 'repositories' {
        metadata {
          code 'web/src/repositories/**'
        }
      }
    }
    trainer_http = service 'trainer-http' {  // docker-compose.yml:15
      technology 'built from a Dockerfile'
      metadata {
        otel_service 'trainer-http'
        resource 'trainer-http'
      }
    }
    trainer_grpc = service 'trainer-grpc' {  // docker-compose.yml:34
      technology 'built from a Dockerfile'
      metadata {
        otel_service 'trainer-grpc'
        resource 'trainer-grpc'
      }
    }
    trainings_http = service 'trainings-http' {  // docker-compose.yml:53
      technology 'built from a Dockerfile'
      metadata {
        otel_service 'trainings-http'
        resource 'trainings-http'
      }
    }
    users_http = service 'users-http' {  // docker-compose.yml:71
      technology 'built from a Dockerfile'
      metadata {
        otel_service 'users-http'
        resource 'users-http'
      }
    }
    users_grpc = service 'users-grpc' {  // docker-compose.yml:90
      technology 'built from a Dockerfile'
      metadata {
        otel_service 'users-grpc'
        resource 'users-grpc'
      }
    }
    firestore = service 'firestore' {  // docker-compose.yml:109
      technology 'built from a Dockerfile'
      metadata {
        otel_service 'firestore'
        resource 'firestore'
      }
    }
    firestore_component_tests = service 'firestore-component-tests' {  // docker-compose.yml:119
      technology 'built from a Dockerfile'
      metadata {
        otel_service 'firestore-component-tests'
        resource 'firestore-component-tests'
      }
    }
    mysql = datastore 'mysql' {  // docker-compose.yml:128
      technology 'mariadb:10'
      metadata {
        resource 'mysql'
      }
    }
    trainer = service 'trainer' {  // internal/trainer/go.mod:1
      technology 'Go · chi · gRPC'
      metadata {
        code 'internal/trainer/**'
        otel_service 'trainer'
        resource 'trainer'
      }
      adapters = component 'adapters' {
        metadata {
          code 'internal/trainer/adapters/**'
        }
      }
      app = component 'app' {
        metadata {
          code 'internal/trainer/app/*'
        }
      }
      command = component 'command' {
        metadata {
          code 'internal/trainer/app/command/**'
        }
      }
      query = component 'query' {
        metadata {
          code 'internal/trainer/app/query/**'
        }
      }
      domain = component 'domain' {
        metadata {
          code 'internal/trainer/domain/**'
        }
      }
      ports = component 'ports' {
        metadata {
          code 'internal/trainer/ports/**'
        }
      }
      service_2 = component 'service' {
        metadata {
          code 'internal/trainer/service/**'
        }
      }
      common = component 'common' {
        metadata {
          code 'internal/common/**'
        }
      }
    }
    Firestore = datastore 'Firestore' {  // internal/trainer/go.mod:6
      technology 'Firestore'
      metadata {
        resource 'Firestore'
      }
    }
    trainings = service 'trainings' {  // internal/trainings/go.mod:1
      technology 'Go · chi'
      metadata {
        code 'internal/trainings/**'
        otel_service 'trainings'
        resource 'trainings'
      }
      adapters_2 = component 'adapters' {
        metadata {
          code 'internal/trainings/adapters/**'
        }
      }
      app_2 = component 'app' {
        metadata {
          code 'internal/trainings/app/*'
        }
      }
      command_2 = component 'command' {
        metadata {
          code 'internal/trainings/app/command/**'
        }
      }
      query_2 = component 'query' {
        metadata {
          code 'internal/trainings/app/query/**'
        }
      }
      domain_2 = component 'domain' {
        metadata {
          code 'internal/trainings/domain/**'
        }
      }
      ports_2 = component 'ports' {
        metadata {
          code 'internal/trainings/ports/**'
        }
      }
      service_3 = component 'service' {
        metadata {
          code 'internal/trainings/service/**'
        }
      }
    }
    users = service 'users' {  // internal/users/go.mod:1
      technology 'Go · chi'
      metadata {
        code 'internal/users/**'
        otel_service 'users'
        resource 'users'
      }
    }
  }

  trainer_http -[request]-> firestore  // env.FIRESTORE_EMULATOR_HOST
  trainer_http -[request]-> trainer_grpc  // env.TRAINER_GRPC_ADDR
  trainer_http -[request]-> users_grpc  // env.USERS_GRPC_ADDR
  trainer_grpc -[request]-> firestore  // env.FIRESTORE_EMULATOR_HOST
  trainer_grpc -[request]-> users_grpc  // env.USERS_GRPC_ADDR
  trainings_http -[request]-> firestore  // env.FIRESTORE_EMULATOR_HOST
  trainings_http -[request]-> trainer_grpc  // env.TRAINER_GRPC_ADDR
  trainings_http -[request]-> users_grpc  // env.USERS_GRPC_ADDR
  users_http -[request]-> firestore  // env.FIRESTORE_EMULATOR_HOST
  users_http -[request]-> trainer_grpc  // env.TRAINER_GRPC_ADDR
  users_http -[request]-> users_grpc  // env.USERS_GRPC_ADDR
  users_grpc -[request]-> firestore  // env.FIRESTORE_EMULATOR_HOST
  users_grpc -[request]-> trainer_grpc  // env.TRAINER_GRPC_ADDR
  firestore -[request]-> trainer_grpc  // env.TRAINER_GRPC_ADDR
  firestore -[request]-> users_grpc  // env.USERS_GRPC_ADDR
  firestore_component_tests -[request]-> firestore  // env.FIRESTORE_EMULATOR_HOST
  firestore_component_tests -[request]-> trainer_grpc  // env.TRAINER_GRPC_ADDR
  firestore_component_tests -[request]-> users_grpc  // env.USERS_GRPC_ADDR
  mysql -[request]-> firestore  // env.FIRESTORE_EMULATOR_HOST
  mysql -[request]-> trainer_grpc  // env.TRAINER_GRPC_ADDR
  mysql -[request]-> users_grpc  // env.USERS_GRPC_ADDR
  adapters -> query
  adapters -> domain
  app -> command
  app -> query
  command -> domain
  query -> domain
  ports -> app
  ports -> command
  ports -> query
  service_2 -> adapters
  service_2 -> app
  service_2 -> command
  service_2 -> query
  service_2 -> domain
  trainer -> Firestore  // reads or writes? say which: -[reads]-> or -[writes]->
  trainer -> mysql  // reads or writes? say which: -[reads]-> or -[writes]->
  adapters_2 -> query_2
  adapters_2 -> domain_2
  app_2 -> command_2
  app_2 -> query_2
  command_2 -> domain_2
  ports_2 -> app_2
  ports_2 -> command_2
  ports_2 -> query_2
  ports_2 -> domain_2
  service_3 -> adapters_2
  service_3 -> app_2
  service_3 -> command_2
  service_3 -> query_2
  trainings -> Firestore  // reads or writes? say which: -[reads]-> or -[writes]->
  users -> Firestore  // reads or writes? say which: -[reads]-> or -[writes]->
  src -> repositories
  repositories -> src
}

specification {
  element domain
  element service
  element event
  element datastore
  element infra
  element component
  relationship request
  relationship publishes
  relationship consumes
  relationship reads
  relationship writes
}
